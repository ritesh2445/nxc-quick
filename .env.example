# =============================================================================
# NXC VERSE — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================

# Application Base URL
APP_URL=https://nxcverse.in
NEXT_PUBLIC_APP_URL=https://nxcverse.in

# Master Session Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=your_super_secret_auth_key_here

# =============================================================================
# CLOUDFLARE D1 DATABASE
# =============================================================================
# D1 Database Name: nxc-verse-db
# In Cloudflare Workers runtime, D1 is accessed directly via the `DB` binding.
# For local Drizzle migrations and CLI operations:
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=your_d1_database_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# =============================================================================
# CLOUDFLARE R2 STORAGE (S3-Compatible Object Store)
# =============================================================================
# Bucket Name: nxc-verse-storage (Private access by default)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=nxc-verse-storage
# Optional public custom domain for public asset delivery (if configured)
R2_PUBLIC_DOMAIN=https://assets.nxcverse.in

# =============================================================================
# PAYMENT GATEWAYS
# =============================================================================
# Razorpay (INR Transactions)
NEXT_PUBLIC_RAZORPAY_KEY=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe (USD Transactions)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# =============================================================================
# TRANSACTIONAL EMAIL PROVIDER
# =============================================================================
# Supported providers: resend, mailchannels, postmark, smtp
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your_api_key_here
EMAIL_FROM=NXC Verse <concierge@nxcverse.in>
EMAIL_REPLY_TO=concierge@nxcverse.in

# =============================================================================
# DIGITAL WALLET INTEGRATIONS
# =============================================================================
# Apple Wallet (.pkpass signing)
APPLE_TEAM_ID=your_apple_developer_team_id
APPLE_PASS_TYPE_IDENTIFIER=pass.in.nxcverse.identity
APPLE_CERTIFICATE_PEM=base64_encoded_certificate_pem_string
APPLE_PRIVATE_KEY_PEM=base64_encoded_private_key_pem_string
APPLE_WWDR_CERTIFICATE_PEM=base64_encoded_apple_wwdr_pem_string

# Google Wallet (Google Pay Passes API)
GOOGLE_WALLET_ISSUER_ID=your_google_wallet_issuer_id
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key\n-----END PRIVATE KEY-----"
